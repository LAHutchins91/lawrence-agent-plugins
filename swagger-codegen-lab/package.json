{
  "name": "swagger-codegen-lab",
  "version": "1.0.0",
  "description": "Local zero-auth MCP for swagger-codegen / openapi-generator CLI text — languages/generators, config/additionalProperties, templates/library, and lite lint — no codegen runtime or network",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "swagger-codegen-lab": "dist/bundle.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/bundle.js",
    "dev": "npx tsx src/index.ts",
    "test": "node scripts/smoke.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "swagger-codegen",
    "openapi-generator",
    "openapi",
    "codegen",
    "developer-tools",
    "cursor"
  ],
  "author": "Lawrence Hutchins",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
