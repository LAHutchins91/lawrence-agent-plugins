{
  "name": "polaris-lab",
  "version": "1.0.0",
  "description": "Local zero-auth MCP for Fairwinds Polaris config heuristics (checks, exemptions, severity) — no polaris CLI, network, or filesystem follow",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "polaris-lab": "dist/bundle.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/bundle.js",
    "dev": "npx tsx src/index.ts",
    "test": "node scripts/smoke.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "polaris",
    "fairwinds",
    "kubernetes",
    "k8s",
    "yaml",
    "developer-tools",
    "cursor"
  ],
  "author": "Lawrence Hutchins",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
